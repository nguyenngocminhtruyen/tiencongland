---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import BlogCard from '@/components/BlogCard.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import Icon from '@/components/Icon.astro';
import CTA from '@/components/CTA.astro';
import Disclaimer from '@/components/Disclaimer.astro';
import ImageGallery from '@/components/ImageGallery.astro';
import VideoSection from '@/components/VideoSection.astro';
import ConstructionProgress from '@/components/ConstructionProgress.astro';
import FaqSection from '@/components/FaqSection.astro';
import { formatDate } from '@/lib/format';
import { blogSlug } from '@/lib/content';
import { SITE } from '@/lib/site';
import { PROJECT_HERO_NOTE, PROJECT_REFERENCE_NOTE, PROPERTY_INFO_NOTE } from '@/lib/legal';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const {
  title,
  tagline,
  seoTitle,
  seoDescription,
  location,
  locationNote,
  type,
  developer,
  status,
  priceLabel,
  legalStatus,
  updatedDate,
  source,
  featuredUnit,
  heroImage,
  gallery,
  highlights,
  lifestyleValues,
  cta,
  relatedPosts,
  productLines,
  infrastructureTimeline,
  progress,
  videos,
  faq,
} = project.data;

const allPosts = await getCollection('blog');
const relatedPostEntries = relatedPosts
  .map((slug) => allPosts.find((p) => blogSlug(p.id) === slug))
  .filter((p): p is CollectionEntry<'blog'> => p !== undefined);

const slugify = (s: string) =>
  s
    .toLowerCase()
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .replace(/đ/g, 'd')
    .replace(/[^a-z0-9]+/g, '-');

const projectProperties = await getCollection('properties', (p) => p.data.projectSlug === project.id);
const productLineLinks = productLines.map((line) => {
  const target = slugify(line.name);
  // Prefer an exact title match (a product line that has its own dedicated property page) over
  // a subdivision match (a product line that's just the umbrella label for other properties).
  const match =
    projectProperties.find((p) => slugify(p.data.title) === target) ??
    projectProperties.find((p) => p.data.subdivision && slugify(p.data.subdivision) === target);
  return match ? `/properties/${match.id}` : `/contact?property=${project.id}-${target}`;
});

const allProjects = await getCollection('projects');
const relatedProjects = allProjects.filter((p) => p.id !== project.id).slice(0, 2);

const lifestyleIcons = ['shield-check', 'users', 'sparkle'] as const;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateListing',
  name: title,
  description: tagline,
  image: [new URL(heroImage, SITE.url).toString(), ...gallery.map((g) => new URL(g.src, SITE.url).toString())],
  url: new URL(`/projects/${project.id}`, SITE.url).toString(),
  address: {
    '@type': 'PostalAddress',
    streetAddress: location,
    addressCountry: 'VN',
  },
};

// BreadcrumbList schema is emitted by <Breadcrumbs> below from the same `items` — don't duplicate it here.
const faqLd =
  faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: { '@type': 'Answer', text: item.answer },
        })),
      }
    : null;

const quickFacts = [
  { icon: 'building' as const, label: 'Tên dự án', value: title },
  { icon: 'map-pin' as const, label: 'Vị trí', value: location },
  { icon: 'award' as const, label: 'Loại hình', value: type },
  { icon: 'users' as const, label: 'Chủ đầu tư', value: developer ?? 'Đang cập nhật' },
  { icon: 'shield-check' as const, label: 'Trạng thái dự án', value: status },
  ...(featuredUnit ? [{ icon: 'bed' as const, label: 'Căn hộ mẫu nổi bật', value: featuredUnit }] : []),
  { icon: 'calendar' as const, label: 'Ngày cập nhật', value: formatDate(updatedDate) },
  { icon: 'shield-check' as const, label: 'Nguồn thông tin', value: source },
];

const DEFAULT_LOCATION_NOTE =
  'Khả năng kết nối đến các khu vực xung quanh nên được khảo sát thực tế. Tôi có thể hỗ trợ sắp xếp lịch tham quan để Quý khách trải nghiệm trực tiếp.';

const highlightImage =
  gallery.find((g) => /phòng tắm|master/i.test(g.caption ?? g.alt)) ?? gallery[0] ?? { src: heroImage, alt: title };

const tocItems = [
  { href: '#quick-facts-heading', label: 'Tổng quan' },
  { href: '#highlight-heading', label: 'Điểm nổi bật' },
  ...(productLines.length > 0 ? [{ href: '#product-lines-heading', label: 'Phân khu / dòng sản phẩm' }] : []),
  { href: '#location-heading', label: 'Vị trí & kết nối' },
  ...(gallery.length > 0 || videos.length > 0 ? [{ href: '#gallery-heading', label: 'Hình ảnh & video' }] : []),
  ...(progress ? [{ href: '#progress-heading', label: 'Tiến độ thi công' }] : []),
  { href: '#price-heading', label: 'Giá bán & chính sách' },
  ...(faq.length > 0 ? [{ href: '#faq-heading', label: 'Câu hỏi thường gặp' }] : []),
];
---

<Layout
  title={seoTitle ?? `${title} – ${type} tại ${location}`}
  description={
    seoDescription ??
    `Tìm hiểu thông tin tham khảo về ${title}, ${type.toLowerCase()} ${developer ? `hợp tác phát triển bởi ${developer} ` : ''}tại ${location}.`
  }
  image={heroImage}
  type="article"
  jsonLd={faqLd ? [jsonLd, faqLd] : jsonLd}
>
  <Breadcrumbs items={[{ label: 'Dự án', href: '/projects' }, { label: title }]} />

  <article>
  <!-- 1. Hero -->
  <header class="container-page">
    <div class="mx-auto max-w-3xl">
      <div class="flex flex-wrap items-center gap-2">
        <span class="badge border-accent-200 bg-accent-50 text-accent-700">{type}</span>
        <span class="badge">{status}</span>
      </div>
      <h1 class="mt-4 font-serif text-3xl font-semibold leading-tight text-primary-900 sm:text-4xl lg:text-[2.75rem]">
        {title}
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-primary-500">{tagline}</p>

      <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-primary-500">
        <span class="flex items-center gap-1.5">
          <Icon name="map-pin" size={16} class="shrink-0 text-primary-400" />
          {location}
        </span>
        {developer && (
          <span class="flex items-center gap-1.5">
            <Icon name="building" size={16} class="shrink-0 text-primary-400" />
            {developer}
          </span>
        )}
      </div>

      <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        <a href="/contact" class="btn-accent justify-center">
          <Icon name="phone" size={17} />
          Nhận bảng giá &amp; đăng ký tư vấn
        </a>
        {relatedPostEntries.length > 0 && (
          <a href={`/blog/${blogSlug(relatedPostEntries[0].id)}`} class="btn-outline justify-center">
            Xem bài viết liên quan
            <Icon name="arrow-right" size={17} />
          </a>
        )}
      </div>

      <Disclaimer text={PROJECT_HERO_NOTE} class="mt-4" />

      {tocItems.length > 2 && (
        <nav aria-label="Mục lục trang dự án" class="mt-6 flex flex-wrap gap-x-4 gap-y-1.5 border-t border-border pt-4 text-sm">
          {tocItems.map((item) => (
            <a href={item.href} class="text-primary-500 hover:text-accent-600">{item.label}</a>
          ))}
        </nav>
      )}
    </div>

    <div class="mx-auto mt-8 max-w-4xl overflow-hidden rounded-xl border border-border shadow-card-hover">
      <img
        src={heroImage}
        alt={title}
        width="1600"
        height="900"
        class="aspect-[16/9] w-full object-cover"
        fetchpriority="high"
      />
    </div>
  </header>

  <!-- 2. Quick facts -->
  <section class="container-page section" aria-labelledby="quick-facts-heading">
    <h2 id="quick-facts-heading" class="font-serif text-2xl font-semibold text-primary-900">Thông tin nhanh</h2>
    <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
      {quickFacts.map((fact) => (
        <div class="rounded-lg border border-border bg-surface-card p-4">
          <span class="flex h-9 w-9 items-center justify-center rounded-full bg-accent-50 text-accent-600">
            <Icon name={fact.icon} size={18} />
          </span>
          <p class="mt-3 text-xs font-medium uppercase tracking-wide text-primary-400">{fact.label}</p>
          <p class="mt-1 text-sm font-semibold leading-snug text-primary-900">{fact.value}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- 3. Highlights -->
  {highlights.length > 0 && (
    <section class="container-page section pt-0" aria-labelledby="highlight-heading">
      <div class="grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-14">
        <div>
          <h2 id="highlight-heading" class="font-serif text-2xl font-semibold text-primary-900">
            {featuredUnit ? `Điểm nổi bật căn hộ ${featuredUnit}` : 'Điểm nổi bật dự án'}
          </h2>
          <p class="mt-3 text-primary-500">
            Theo thông tin giới thiệu/tài liệu bán hàng tại thời điểm cập nhật, dự án có những điểm đáng chú ý sau:
          </p>
          <ul class="mt-6 space-y-3">
            {highlights.map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-primary-700">
                <Icon name="check-circle" size={18} class="mt-0.5 shrink-0 text-accent-600" />
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div class="overflow-hidden rounded-xl border border-border shadow-card">
          <img
            src={highlightImage.src}
            alt={highlightImage.alt}
            width="900"
            height="1100"
            loading="lazy"
            class="aspect-[4/5] w-full object-cover"
          />
        </div>
      </div>
    </section>
  )}

  <!-- 4. Lifestyle values -->
  {lifestyleValues.length > 0 && (
    <section class="bg-primary-50 py-16 sm:py-20" aria-labelledby="lifestyle-heading">
      <div class="container-page">
        <h2 id="lifestyle-heading" class="font-serif text-2xl font-semibold text-primary-900">Không gian sống</h2>
        <div class="mt-8 grid gap-6 sm:grid-cols-3">
          {lifestyleValues.map((value, i) => (
            <div class="rounded-xl border border-border bg-surface-card p-6">
              <span class="flex h-11 w-11 items-center justify-center rounded-full bg-accent-50 text-accent-600">
                <Icon name={lifestyleIcons[i % lifestyleIcons.length]} size={20} filled={lifestyleIcons[i % lifestyleIcons.length] === 'sparkle'} />
              </span>
              <h3 class="mt-4 font-serif text-lg font-semibold text-primary-900">{value.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-primary-500">{value.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 5. Product lines / phân khu -->
  {productLines.length > 0 && (
    <section class="container-page section" aria-labelledby="product-lines-heading">
      <h2 id="product-lines-heading" class="font-serif text-2xl font-semibold text-primary-900">Phân khu / dòng sản phẩm</h2>
      <p class="mt-2 max-w-2xl text-primary-500">
        Dự án gồm nhiều phân khu khác nhau. Thông tin dưới đây mang tính giới thiệu tổng quan — số lượng căn, diện tích và
        giá bán cụ thể vui lòng liên hệ để được cập nhật theo từng phân khu.
      </p>
      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        {productLines.map((line, i) => (
          <div class="card flex flex-col overflow-hidden">
            <div class="aspect-[4/3] overflow-hidden bg-primary-100">
              <img
                src={line.image}
                alt={`Phối cảnh minh họa ${line.name}`}
                loading="lazy"
                decoding="async"
                width="800"
                height="600"
                class="h-full w-full object-cover"
              />
            </div>
            <div class="flex flex-1 flex-col p-6">
              <span class="badge w-fit border-accent-200 bg-accent-50 text-accent-700">{line.type}</span>
              <h3 class="mt-3 font-serif text-lg font-semibold text-primary-900">{line.name}</h3>
              {line.tagline && <p class="mt-1 text-sm font-medium text-primary-600">{line.tagline}</p>}
              <p class="mt-3 flex-1 text-sm leading-relaxed text-primary-500">{line.description}</p>
              <a href={productLineLinks[i]} class="btn-outline mt-5 justify-center text-sm">
                {productLineLinks[i].startsWith('/properties/') ? 'Xem chi tiết' : 'Nhận thông tin'} {line.name}
                <Icon name="arrow-right" size={16} />
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- 6. Location & connectivity -->
  <section class="bg-primary-50 py-16 sm:py-20" aria-labelledby="location-heading">
    <div class="container-page">
      <h2 id="location-heading" class="font-serif text-2xl font-semibold text-primary-900">Vị trí &amp; kết nối</h2>
      <div class="mt-6 max-w-2xl rounded-xl border border-border bg-surface-card p-6">
        <p class="flex items-start gap-3 text-primary-800">
          <Icon name="map-pin" size={20} class="mt-0.5 shrink-0 text-accent-600" />
          <span class="font-medium">{location}</span>
        </p>
        <p class="mt-4 text-sm leading-relaxed text-primary-500">
          {locationNote ?? DEFAULT_LOCATION_NOTE}
        </p>
      </div>

      {infrastructureTimeline.length > 0 && (
        <div class="mt-10">
          <h3 class="font-serif text-lg font-semibold text-primary-900">Lộ trình hạ tầng kết nối (theo quy hoạch)</h3>
          <p class="mt-2 max-w-2xl text-sm text-primary-500">
            Các mốc thời gian dưới đây theo tài liệu quy hoạch/công bố của chủ đầu tư tại thời điểm cập nhật, luôn mang
            tính dự kiến và có thể thay đổi theo quyết định của cơ quan nhà nước có thẩm quyền.
          </p>
          <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {infrastructureTimeline.map((group) => (
              <div class="rounded-lg border border-border bg-surface-card p-4">
                <p class="font-serif text-xl font-semibold text-accent-600">{group.year}</p>
                <ul class="mt-3 space-y-2.5">
                  {group.items.map((item) => (
                    <li class="text-sm">
                      <span class="font-medium text-primary-800">{item.label}</span>
                      {item.note && <span class="mt-0.5 block text-xs text-primary-400">{item.note}</span>}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- 7. Gallery & video -->
  {(gallery.length > 0 || videos.length > 0) && (
    <section class="container-page section" aria-labelledby="gallery-heading">
      <h2 id="gallery-heading" class="font-serif text-2xl font-semibold text-primary-900">
        {featuredUnit ? 'Không gian thực tế căn hộ mẫu' : 'Hình ảnh & video dự án'}
      </h2>
      <p class="mt-2 max-w-2xl text-primary-500">
        Hình ảnh/video theo tài liệu giới thiệu tại thời điểm cập nhật. Các phối cảnh mang tính minh họa, không phải hình
        ảnh thực tế trừ khi được ghi chú cụ thể.
      </p>
      {gallery.length > 0 && <ImageGallery items={gallery} class="mt-8" />}
      {videos.length > 0 && (
        <div class="mt-8">
          <VideoSection videos={videos} />
        </div>
      )}
    </section>
  )}

  <!-- 8. Construction progress -->
  {progress && (
    <ConstructionProgress
      updatedDate={progress.updatedDate}
      summary={progress.summary}
      sourceLabel={progress.sourceLabel}
      sourceUrl={progress.sourceUrl}
      videos={progress.videos}
    />
  )}

  <!-- 9. Price and policy -->
  <section class="container-page section" aria-labelledby="price-heading">
    <h2 id="price-heading" class="font-serif text-2xl font-semibold text-primary-900">Giá bán và chính sách</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-3">
      <div class="rounded-lg border border-border bg-surface-card p-5">
        <p class="text-xs font-medium uppercase tracking-wide text-primary-400">Giá bán</p>
        <p class="mt-1.5 text-sm font-semibold text-primary-900">{priceLabel}</p>
      </div>
      <div class="rounded-lg border border-border bg-surface-card p-5">
        <p class="text-xs font-medium uppercase tracking-wide text-primary-400">Chính sách bán hàng</p>
        <p class="mt-1.5 text-sm font-semibold text-primary-900">
          Cập nhật theo thông báo của chủ đầu tư/công ty phân phối
        </p>
      </div>
      <div class="rounded-lg border border-border bg-surface-card p-5">
        <p class="text-xs font-medium uppercase tracking-wide text-primary-400">Tình trạng sản phẩm</p>
        <p class="mt-1.5 text-sm font-semibold text-primary-900">{status}</p>
        <p class="mt-1 text-xs text-primary-400">Vui lòng liên hệ để kiểm tra tình trạng sản phẩm mới nhất</p>
      </div>
    </div>
    <p class="mt-4 text-xs text-primary-400">Pháp lý: {legalStatus}</p>
    <Disclaimer text={PROPERTY_INFO_NOTE} class="mt-4" />
  </section>

  <!-- 10. FAQ -->
  {faq.length > 0 && (
    <section class="container-page section pt-0" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="font-serif text-2xl font-semibold text-primary-900">Câu hỏi thường gặp</h2>
      <FaqSection faq={faq} class="mt-8 max-w-3xl" />
    </section>
  )}

  <!-- 11. CTA -->
  <section class="container-page pb-4">
    <CTA
      title={cta?.headline ?? `Quan tâm ${title}?`}
      text={
        cta?.text ??
        'Tôi có thể hỗ trợ Quý khách kiểm tra thông tin mới nhất, tư vấn loại sản phẩm phù hợp và sắp xếp lịch tìm hiểu thực tế nếu có nhu cầu.'
      }
      primaryLabel="Nhận bảng giá & tư vấn"
      primaryHref="/contact"
      secondaryLabel="Xem thông tin liên hệ"
      secondaryHref="/contact#lien-he"
    />
  </section>
  </article>

  <!-- 12. Related content -->
  {(relatedPostEntries.length > 0 || relatedProjects.length > 0) && (
    <section class="container-page section pt-8" aria-labelledby="related-heading">
      <h2 id="related-heading" class="font-serif text-2xl font-semibold text-primary-900">Nội dung liên quan</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {relatedPostEntries.map((post) => <BlogCard post={post} />)}
        {relatedProjects.map((p) => <ProjectCard project={p} />)}
      </div>
    </section>
  )}

  <!-- 13. Compliance / reference -->
  <section class="container-page pb-16">
    <Disclaimer variant="box" text={PROJECT_REFERENCE_NOTE} />
  </section>
</Layout>
