---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import FaqCard from '@/components/FaqCard.astro';

const pages = (await getCollection('faq', (p) => !p.data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
const categories = [...new Set(pages.map((p) => p.data.category))];
---

<Layout
  title="Câu hỏi thường gặp"
  description="Giải đáp các câu hỏi thường gặp về mua bán căn hộ, pháp lý giao dịch và tìm hiểu bất động sản tại TP.HCM — thông tin tham khảo, cập nhật theo tài liệu/thông tin bán hàng tại thời điểm đăng tải."
>
  <Breadcrumbs items={[{ label: 'Câu hỏi thường gặp' }]} />

  <section class="container-page pb-10">
    <h1 class="font-serif text-3xl font-semibold sm:text-4xl">Câu hỏi thường gặp</h1>
    <p class="mt-3 max-w-2xl text-primary-500">
      Tổng hợp các câu hỏi khách hàng thường đặt ra trước khi tìm hiểu hoặc quyết định giao dịch bất động sản. Nội dung mang tính tham khảo, vui lòng liên hệ để kiểm tra thông tin mới nhất.
    </p>
    {categories.length > 0 && (
      <div class="mt-5 flex flex-wrap gap-2">
        <span class="badge">Tất cả</span>
        {categories.map((c) => <span class="badge">{c}</span>)}
      </div>
    )}
  </section>

  <section class="container-page section pt-0">
    {pages.length > 0 ? (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {pages.map((page) => <FaqCard page={page} />)}
      </div>
    ) : (
      <p class="py-16 text-center text-primary-400">
        Hiện chưa có nội dung FAQ nào được đăng. <a href="/contact/" class="font-medium text-accent-600 hover:underline">Liên hệ tư vấn</a> để được giải đáp trực tiếp.
      </p>
    )}
  </section>
</Layout>
