---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import Disclaimer from '@/components/Disclaimer.astro';
import { GLOBAL_DISCLAIMER } from '@/lib/legal';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.updatedDate.valueOf() - a.data.updatedDate.valueOf()
);
---

<Layout
  title="Dự án đang tư vấn"
  description="Danh sách dự án bất động sản mà tôi đang hỗ trợ tư vấn và cập nhật thông tin tham khảo tại TP.HCM và khu vực lân cận."
>
  <Breadcrumbs items={[{ label: 'Dự án' }]} />

  <section class="container-page pb-8">
    <h1 class="font-serif text-3xl font-semibold sm:text-4xl">Dự án đang tư vấn</h1>
    <p class="mt-3 max-w-2xl text-primary-500">
      Đây là trang thông tin cá nhân, tổng hợp các dự án tôi đang hỗ trợ tư vấn và kết nối khách hàng quan tâm — không
      phải website chính thức của chủ đầu tư hay sàn giao dịch. Thông tin dự án được cập nhật theo nguồn công bố/tài
      liệu bán hàng tại thời điểm đăng tải.
    </p>
  </section>

  <section class="container-page section pt-0">
    {projects.length > 0 ? (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    ) : (
      <p class="py-16 text-center text-primary-400">Hiện chưa có dự án nào được cập nhật.</p>
    )}

    <Disclaimer text={GLOBAL_DISCLAIMER} class="mt-10 max-w-3xl" />
  </section>
</Layout>
