---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Icon from '@/components/Icon.astro';
import { formatArea, formatDate, formatPrice, statusLabel, typeLabel } from '@/lib/format';
import { blogSlug } from '@/lib/content';
import { SITE } from '@/lib/site';
import { PROPERTY_INFO_NOTE, PAYMENT_RISK_NOTE } from '@/lib/legal';
import Disclaimer from '@/components/Disclaimer.astro';
import CTA from '@/components/CTA.astro';
import ImageGallery from '@/components/ImageGallery.astro';
import VideoSection from '@/components/VideoSection.astro';
import RelatedProperties from '@/components/RelatedProperties.astro';
import RelatedPosts from '@/components/RelatedPosts.astro';
import FaqSection from '@/components/FaqSection.astro';

export async function getStaticPaths() {
  const properties = await getCollection('properties');
  return properties.map((property) => ({
    params: { slug: property.id },
    props: { property },
  }));
}

interface Props {
  property: CollectionEntry<'properties'>;
}

const { property } = Astro.props;
const {
  title,
  description,
  intro,
  audienceFit,
  projectSlug,
  subdivision,
  subdivisionSlug,
  status,
  propertyType,
  price,
  priceUnit,
  priceLabel,
  district,
  city,
  address,
  bedrooms,
  bathrooms,
  area,
  areaLabel,
  legalStatus,
  developer,
  infoSource,
  updatedDate,
  handover,
  handoverStandard,
  heroImage,
  gallery,
  videos,
  designHighlights,
  valueHighlights,
  amenities,
  faq,
  relatedPosts,
  seoTitle,
  seoDescription,
  publishDate,
} = property.data;

const infoUpdatedDate = updatedDate ?? publishDate;
const locationLabel = [address, district, city].filter(Boolean).join(', ');

const allProjects = await getCollection('projects');
const parentProject = projectSlug ? allProjects.find((p) => p.id === projectSlug) : undefined;

const allProperties = await getCollection('properties');
const related = allProperties
  .filter(
    (p) =>
      p.id !== property.id &&
      ((projectSlug && p.data.projectSlug === projectSlug) || p.data.propertyType === propertyType)
  )
  .slice(0, 3);

const allPosts = await getCollection('blog');
const relatedPostEntries = relatedPosts
  .map((slug) => allPosts.find((p) => blogSlug(p.id) === slug))
  .filter((p): p is CollectionEntry<'blog'> => p !== undefined);

const valueIcons = ['shield-check', 'map-pin', 'expand', 'sparkle'] as const;

const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateListing',
  name: title,
  description,
  image: [heroImage, ...gallery.map((g) => g.src)].map((src) => new URL(src, SITE.url).toString()),
  url: new URL(`/properties/${property.id}`, SITE.url).toString(),
  datePosted: publishDate.toISOString().slice(0, 10),
};
if (locationLabel) {
  jsonLd.address = {
    '@type': 'PostalAddress',
    ...(address ? { streetAddress: address } : {}),
    ...(district ? { addressLocality: district } : {}),
    addressRegion: city,
    addressCountry: 'VN',
  };
}
// Chỉ đưa `offers` vào schema khi có giá xác nhận thật — không bịa số liệu vào dữ liệu có cấu trúc.
if (price && priceUnit) {
  jsonLd.offers = {
    '@type': 'Offer',
    price,
    priceCurrency: 'VND',
    availability: status === 'sold' ? 'https://schema.org/SoldOut' : 'https://schema.org/InStock',
  };
}

const breadcrumbItems = parentProject
  ? [
      { label: 'Dự án', href: '/projects/' },
      { label: parentProject.data.title, href: `/projects/${parentProject.id}/` },
      { label: title },
    ]
  : [{ label: 'Bất động sản', href: '/properties/' }, { label: title }];

const faqLd =
  faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: { '@type': 'Answer', text: item.answer },
        })),
      }
    : null;

// BreadcrumbList schema is emitted by <Breadcrumbs> below from the same `breadcrumbItems` — don't duplicate it here.
const jsonLdEntries = [jsonLd, ...(faqLd ? [faqLd] : [])];
---

<Layout
  title={seoTitle ?? title}
  description={seoDescription ?? description}
  image={heroImage}
  type="article"
  jsonLd={jsonLdEntries}
>
  <Breadcrumbs items={breadcrumbItems} />

  <!-- 1. Hero -->
  <section class="container-page pb-10">
    <div class="grid gap-8 lg:grid-cols-2 lg:items-center lg:gap-12">
      <div>
        <div class="flex flex-wrap items-center gap-2">
          {subdivision && subdivisionSlug && (
            <a
              href={`/properties/${subdivisionSlug}/`}
              class="badge relative border-accent-200 bg-accent-50 text-accent-700 hover:bg-accent-100 after:absolute after:-inset-2.5 after:content-['']"
            >
              {subdivision}
            </a>
          )}
          {subdivision && !subdivisionSlug && <span class="badge border-accent-200 bg-accent-50 text-accent-700">{subdivision}</span>}
          <span class="badge">{typeLabel(propertyType)}</span>
          <span class="badge">{statusLabel(status)}</span>
        </div>
        <h1 class="mt-3 font-serif text-2xl font-semibold text-primary-900 sm:text-3xl">{title}</h1>
        {parentProject && (
          <a href={`/projects/${parentProject.id}/`} class="mt-2 inline-flex items-center gap-1.5 text-sm font-medium text-primary-500 hover:text-accent-600">
            <Icon name="building" size={15} class="shrink-0" />
            Thuộc dự án {parentProject.data.title}
          </a>
        )}
        {locationLabel && (
          <p class="mt-2 flex items-center gap-1.5 text-primary-500">
            <Icon name="map-pin" size={18} class="shrink-0 text-primary-400" />
            {locationLabel}
          </p>
        )}
        <p class="mt-4 leading-relaxed text-primary-600">{description}</p>

        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <a href={`/contact/?property=${property.id}`} class="btn-accent justify-center">
            <Icon name="envelope" size={17} />
            Nhận thông tin chi tiết
          </a>
          <a href="#gallery-heading" class="btn-outline justify-center">
            Xem hình ảnh &amp; video
          </a>
          <a href={`tel:${SITE.phone.replace(/\s/g, '')}`} class="btn-outline justify-center">
            <Icon name="phone" size={17} />
            Đặt lịch tư vấn
          </a>
        </div>
      </div>

      <div class="overflow-hidden rounded-xl border border-border shadow-card-hover">
        <img
          src={heroImage}
          alt={title}
          width="1200"
          height="900"
          class="aspect-[4/3] w-full object-cover"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- 2. Quick facts -->
  <section class="container-page section pt-0" aria-labelledby="quick-facts-heading">
    <h2 id="quick-facts-heading" class="font-serif text-xl font-semibold text-primary-900">Thông tin nhanh</h2>
    <dl class="mt-5 grid grid-cols-1 gap-x-6 gap-y-3 rounded-lg border border-border bg-surface-card p-5 text-sm sm:grid-cols-2">
      {subdivision && (
        <div class="flex justify-between gap-4 border-b border-border/60 py-2 sm:border-0 sm:py-0">
          <dt class="shrink-0 text-primary-500">Phân khu</dt>
          <dd class="text-right font-medium text-primary-800">{subdivision}</dd>
        </div>
      )}
      <div class="flex justify-between gap-4 border-b border-border/60 py-2 sm:border-0 sm:py-0">
        <dt class="shrink-0 text-primary-500">Loại hình</dt>
        <dd class="text-right font-medium text-primary-800">{typeLabel(propertyType)}</dd>
      </div>
      {area && (
        <div class="flex justify-between gap-4 border-b border-border/60 py-2 sm:border-0 sm:py-0">
          <dt class="shrink-0 text-primary-500">Diện tích</dt>
          <dd class="text-right font-medium text-primary-800">{formatArea(area)}</dd>
        </div>
      )}
      {!area && areaLabel && (
        <div class="flex justify-between gap-4 border-b border-border/60 py-2 sm:border-0 sm:py-0">
          <dt class="shrink-0 text-primary-500">Diện tích</dt>
          <dd class="text-right font-medium text-primary-800">{areaLabel}</dd>
        </div>
      )}
      {Boolean(bedrooms) && (
        <div class="flex justify-between gap-4 border-b border-border/60 py-2 sm:border-0 sm:py-0">
          <dt class="shrink-0 text-primary-500">Số phòng ngủ</dt>
          <dd class="text-right font-medium text-primary-800">{bedrooms}</dd>
        </div>
      )}
      {Boolean(bathrooms) && (
        <div class="flex justify-between gap-4 border-b border-border/60 py-2 sm:border-0 sm:py-0">
          <dt class="shrink-0 text-primary-500">Số phòng tắm</dt>
          <dd class="text-right font-medium text-primary-800">{bathrooms}</dd>
        </div>
      )}
      <div class="flex justify-between gap-4 border-b border-border/60 py-2 sm:border-0 sm:py-0">
        <dt class="shrink-0 text-primary-500">Tình trạng</dt>
        <dd class="text-right font-medium text-primary-800">{statusLabel(status)}</dd>
      </div>
      <div class="flex justify-between gap-4 border-b border-border/60 py-2 sm:border-0 sm:py-0">
        <dt class="shrink-0 text-primary-500">Giá bán</dt>
        <dd class="text-right font-medium text-primary-800">{price && priceUnit ? formatPrice(price, priceUnit) : priceLabel}</dd>
      </div>
      {handover && (
        <div class="flex justify-between gap-4 border-b border-border/60 py-2 sm:border-0 sm:py-0">
          <dt class="shrink-0 text-primary-500">Bàn giao dự kiến</dt>
          <dd class="text-right font-medium text-primary-800">{handover}</dd>
        </div>
      )}
      <div class="flex justify-between gap-4 py-2 sm:col-span-2">
        <dt class="shrink-0 text-primary-500">Cập nhật lần cuối</dt>
        <dd class="text-right font-medium text-primary-800">{formatDate(infoUpdatedDate)}</dd>
      </div>
    </dl>
    <Disclaimer text={PROPERTY_INFO_NOTE} class="mt-4" />
  </section>

  <!-- 3. Giới thiệu sản phẩm -->
  {intro && (
    <section class="container-page section pt-0" aria-labelledby="intro-heading">
      <h2 id="intro-heading" class="font-serif text-xl font-semibold text-primary-900">Giới thiệu sản phẩm</h2>
      <p class="mt-4 max-w-3xl leading-relaxed text-primary-600">{intro}</p>
      {audienceFit && (
        <div class="mt-5 max-w-3xl rounded-lg border border-border bg-primary-50/60 p-4 text-sm text-primary-600">
          <p class="font-medium text-primary-800">Phù hợp với</p>
          <p class="mt-1">{audienceFit}</p>
        </div>
      )}
    </section>
  )}

  <!-- 4. Thiết kế và công năng -->
  {designHighlights.length > 0 && (
    <section class="container-page section pt-0" aria-labelledby="design-heading">
      <h2 id="design-heading" class="font-serif text-xl font-semibold text-primary-900">Thiết kế và công năng</h2>
      <ul class="mt-5 grid gap-3 sm:grid-cols-2">
        {designHighlights.map((item) => (
          <li class="flex items-start gap-2.5 text-sm text-primary-700">
            <Icon name="check-circle" size={18} class="mt-0.5 shrink-0 text-accent-600" />
            {item}
          </li>
        ))}
      </ul>
      {handoverStandard && (
        <p class="mt-4 max-w-2xl text-sm text-primary-500">
          <span class="font-medium text-primary-800">Tiêu chuẩn bàn giao: </span>{handoverStandard}
        </p>
      )}
      {amenities.length > 0 && (
        <div class="mt-6">
          <p class="text-sm font-medium text-primary-800">Tiện ích liên quan</p>
          <ul class="mt-3 grid grid-cols-1 gap-2.5 sm:grid-cols-2">
            {amenities.map((a) => (
              <li class="flex items-center gap-2.5 text-sm text-primary-700">
                <Icon name="check-circle" size={16} class="shrink-0 text-accent-600" />
                {a}
              </li>
            ))}
          </ul>
        </div>
      )}
    </section>
  )}

  <!-- 5. Giá trị nổi bật -->
  {valueHighlights.length > 0 && (
    <section class="bg-primary-50 py-16 sm:py-20" aria-labelledby="value-heading">
      <div class="container-page">
        <h2 id="value-heading" class="font-serif text-xl font-semibold text-primary-900">Giá trị nổi bật</h2>
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {valueHighlights.map((value, i) => (
            <div class="rounded-xl border border-border bg-surface-card p-5">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-accent-50 text-accent-600">
                <Icon name={valueIcons[i % valueIcons.length]} size={18} filled={valueIcons[i % valueIcons.length] === 'sparkle'} />
              </span>
              <h3 class="mt-3 font-serif text-base font-semibold text-primary-900">{value.title}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-primary-500">{value.description}</p>
            </div>
          ))}
        </div>
        <p class="mt-6 max-w-2xl text-xs text-primary-400">
          Các giá trị trên mang tính mô tả không gian sống theo tài liệu giới thiệu, không phải cam kết về khả năng sinh
          lời hay tăng giá trong tương lai.
        </p>
      </div>
    </section>
  )}

  <!-- 6. Gallery -->
  {gallery.length > 0 && (
    <section class="container-page section" aria-labelledby="gallery-heading">
      <h2 id="gallery-heading" class="font-serif text-xl font-semibold text-primary-900">Thư viện hình ảnh</h2>
      <p class="mt-2 max-w-2xl text-sm text-primary-500">
        Hình ảnh theo tài liệu giới thiệu tại thời điểm cập nhật, mang tính minh họa trừ khi được ghi chú là ảnh/video
        thực tế.
      </p>
      <ImageGallery items={gallery} class="mt-6" />

      {videos.length > 0 && (
        <div class="mt-8">
          <h3 class="font-serif text-lg font-semibold text-primary-900">Video thực tế</h3>
          <div class="mt-4">
            <VideoSection videos={videos} />
          </div>
        </div>
      )}
    </section>
  )}

  <!-- 7. Details table -->
  <section class="container-page section pt-0" aria-labelledby="details-heading">
    <h2 id="details-heading" class="font-serif text-xl font-semibold text-primary-900">Thông tin chi tiết</h2>
    <dl class="mt-5 grid grid-cols-1 gap-x-6 gap-y-3 text-sm sm:grid-cols-2">
      {developer && (
        <div class="flex justify-between gap-4 border-b border-border/60 py-2 sm:border-0 sm:py-0">
          <dt class="shrink-0 text-primary-500">Chủ đầu tư</dt>
          <dd class="text-right font-medium text-primary-800">{developer}</dd>
        </div>
      )}
      {legalStatus && (
        <div class="flex justify-between gap-4 border-b border-border/60 py-2 sm:border-0 sm:py-0">
          <dt class="shrink-0 text-primary-500">Tình trạng pháp lý</dt>
          <dd class="text-right font-medium text-primary-800">{legalStatus}</dd>
        </div>
      )}
      <div class="flex justify-between gap-4 py-2 sm:col-span-2">
        <dt class="shrink-0 text-primary-500">Nguồn thông tin</dt>
        <dd class="text-right font-medium text-primary-800">{infoSource}</dd>
      </div>
    </dl>
    <Disclaimer text={PAYMENT_RISK_NOTE} class="mt-4" />
    <p class="mt-3 text-xs text-primary-400">{SITE.license}</p>
  </section>

  <!-- 8. FAQ -->
  {faq.length > 0 && (
    <section class="container-page section pt-0" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="font-serif text-xl font-semibold text-primary-900">Câu hỏi thường gặp</h2>
      <FaqSection faq={faq} />
    </section>
  )}

  <!-- 9. Related properties + blog -->
  {(related.length > 0 || relatedPostEntries.length > 0) && (
    <section class="section bg-primary-50 pt-16 sm:pt-20">
      <div class="container-page space-y-10">
        <RelatedProperties properties={related} />
        <RelatedPosts posts={relatedPostEntries} />
      </div>
    </section>
  )}

  <!-- 10. CTA -->
  <section class="container-page section">
    <CTA
      title={`Quan tâm ${title}?`}
      text="Tôi có thể hỗ trợ Quý khách kiểm tra thông tin mới nhất, so sánh với các sản phẩm cùng phân khúc và sắp xếp lịch tìm hiểu thực tế nếu có nhu cầu."
      primaryLabel="Nhận thông tin chi tiết"
      primaryHref={`/contact/?property=${property.id}`}
      secondaryLabel={`Gọi tư vấn — ${SITE.phoneDisplay}`}
      secondaryHref={`tel:${SITE.phone.replace(/\s/g, '')}`}
    />
  </section>
</Layout>
