---
import Icon from './Icon.astro';
import type { IconName } from '@/lib/icon-names';

interface Props {
  icon: IconName;
  value: string;
  label: string;
}

const { icon, value, label } = Astro.props;
---

<div class="flex flex-col items-center gap-2 text-center sm:items-start sm:text-left">
  <span class="flex h-11 w-11 items-center justify-center rounded-full bg-accent-50 text-accent-600">
    <Icon name={icon} size={22} />
  </span>
  <span class="font-serif text-3xl font-semibold text-primary-900 sm:text-4xl">{value}</span>
  <span class="text-sm text-primary-500">{label}</span>
</div>
