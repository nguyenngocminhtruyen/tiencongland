---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  class?: string;
  id?: string;
}

const { eyebrow, title, description, align = 'left', class: className = '', id } = Astro.props;
const alignClass = align === 'center' ? 'text-center mx-auto' : 'text-left';
---

<div class={`max-w-2xl ${alignClass} ${className}`}>
  {eyebrow && (
    <p class="mb-3 flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-accent-600" class:list={{ 'justify-center': align === 'center' }}>
      <span class="h-px w-6 bg-accent-400"></span>
      {eyebrow}
    </p>
  )}
  <h2 id={id} class="text-3xl font-semibold sm:text-4xl">{title}</h2>
  {description && <p class="mt-4 text-lg text-primary-500">{description}</p>}
</div>
