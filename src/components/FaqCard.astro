---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { formatDate } from '@/lib/format';

interface Props {
  page: CollectionEntry<'faq'>;
}

const { page } = Astro.props;
const { title, description, publishDate, category, image, imageAlt, faq } = page.data;
const href = `/faq/${page.id}/`;
---

<article class="card group flex flex-col overflow-hidden hover:shadow-card-hover">
  <a href={href} class="relative block aspect-[3/2] overflow-hidden bg-primary-100">
    <img
      src={image}
      alt={imageAlt ?? title}
      loading="lazy"
      decoding="async"
      width="1200"
      height="800"
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
    <span class="absolute left-3 top-3 rounded-full bg-white/90 px-3 py-1 text-xs font-medium text-primary-800 backdrop-blur">
      {category}
    </span>
  </a>
  <div class="flex flex-1 flex-col p-5">
    <p class="flex items-center gap-1.5 text-xs text-primary-400">
      <Icon name="calendar" size={14} />
      {formatDate(publishDate)}
      <span aria-hidden="true">·</span>
      {faq.length} câu hỏi
    </p>
    <a href={href} class="mt-2 line-clamp-2 font-serif text-lg font-semibold text-primary-900 hover:text-accent-600">
      {title}
    </a>
    <p class="mt-2 line-clamp-2 flex-1 text-sm text-primary-500">{description}</p>
    <a href={href} class="mt-4 flex items-center gap-1 text-sm font-medium text-primary-700 hover:text-accent-600">
      Xem câu trả lời
      <Icon name="arrow-right" size={16} />
    </a>
  </div>
</article>
