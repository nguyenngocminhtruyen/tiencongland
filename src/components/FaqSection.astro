---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  faq: FaqItem[];
  class?: string;
}

const { faq, class: className = 'mt-6 max-w-3xl' } = Astro.props;
---

{faq.length > 0 && (
  <div class:list={['faq-list not-prose', className]}>
    {faq.map((item) => (
      <details class="faq-item">
        <summary>{item.question}</summary>
        <div><p>{item.answer}</p></div>
      </details>
    ))}
  </div>
)}
