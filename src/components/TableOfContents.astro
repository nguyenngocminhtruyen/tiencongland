---
import Icon from './Icon.astro';
import TocList from './TocList.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  class?: string;
  collapsible?: boolean;
}

const { headings, class: className = '', collapsible = false } = Astro.props;
const items = headings.filter((h) => h.depth === 2);
---

{
  items.length > 1 &&
    (collapsible ? (
      <details class:list={['toc rounded-lg border border-border bg-surface-card px-5', className]}>
        <summary class="flex cursor-pointer list-none items-center gap-2 py-4 text-xs font-semibold uppercase tracking-wide text-primary-500 marker:content-none">
          <Icon name="list" size={15} class="shrink-0 text-accent-600" />
          Mục lục bài viết
        </summary>
        <div class="pb-4">
          <TocList items={items} />
        </div>
      </details>
    ) : (
      <nav aria-label="Mục lục bài viết" class:list={['toc rounded-lg border border-border bg-surface-card p-5', className]}>
        <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-primary-400">
          <Icon name="list" size={15} class="shrink-0 text-accent-600" />
          Mục lục
        </p>
        <TocList items={items} />
      </nav>
    ))
}

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
  if (links.length > 0) {
    const targets = Array.from(new Set(Array.from(links).map((l) => l.dataset.tocLink)))
      .map((slug) => (slug ? document.getElementById(slug) : null))
      .filter((el): el is HTMLElement => el !== null);

    const setActive = (slug: string | null) => {
      links.forEach((link) => {
        link.setAttribute('aria-current', link.dataset.tocLink === slug ? 'true' : 'false');
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (visible) setActive(visible.target.id);
      },
      { rootMargin: '-15% 0px -65% 0px', threshold: 0 }
    );

    targets.forEach((el) => observer.observe(el));
  }
</script>
