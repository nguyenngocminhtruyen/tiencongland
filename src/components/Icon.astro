---
import type { IconName } from '@/lib/icon-names';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  strokeWidth?: number;
  filled?: boolean;
}

const { name, size = 20, class: className = '', strokeWidth = 1.75, filled = false } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={filled ? 'currentColor' : 'none'}
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  {name === 'phone' && (
    <>
      <rect x="7" y="2" width="10" height="20" rx="2" />
      <line x1="10.5" y1="18.5" x2="13.5" y2="18.5" />
    </>
  )}
  {name === 'envelope' && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <polyline points="3.5,6 12,13 20.5,6" />
    </>
  )}
  {name === 'map-pin' && (
    <>
      <path d="M12 21s-7-7.373-7-12a7 7 0 1 1 14 0c0 4.627-7 12-7 12z" />
      <circle cx="12" cy="9" r="2.5" />
    </>
  )}
  {name === 'chevron-down' && <polyline points="5,8.5 12,15.5 19,8.5" />}
  {name === 'chevron-right' && <polyline points="8.5,5 15.5,12 8.5,19" />}
  {name === 'chevron-left' && <polyline points="15.5,5 8.5,12 15.5,19" />}
  {name === 'arrow-right' && (
    <>
      <line x1="4" y1="12" x2="19" y2="12" />
      <polyline points="13,6 19,12 13,18" />
    </>
  )}
  {name === 'menu' && (
    <>
      <line x1="3" y1="6" x2="21" y2="6" />
      <line x1="3" y1="12" x2="21" y2="12" />
      <line x1="3" y1="18" x2="21" y2="18" />
    </>
  )}
  {name === 'close' && (
    <>
      <line x1="6" y1="6" x2="18" y2="18" />
      <line x1="18" y1="6" x2="6" y2="18" />
    </>
  )}
  {name === 'check-circle' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <polyline points="8,12.5 11,15.5 16,9" />
    </>
  )}
  {name === 'shield-check' && (
    <>
      <path d="M12 3 5 5.5V11c0 5 3 8.5 7 10 4-1.5 7-5 7-10V5.5z" />
      <polyline points="9,12 11,14.2 15.5,9.3" />
    </>
  )}
  {name === 'calendar' && (
    <>
      <rect x="3.5" y="5" width="17" height="16" rx="2" />
      <line x1="3.5" y1="9.5" x2="20.5" y2="9.5" />
      <line x1="8" y1="2.5" x2="8" y2="7" />
      <line x1="16" y1="2.5" x2="16" y2="7" />
    </>
  )}
  {name === 'search' && (
    <>
      <circle cx="10.5" cy="10.5" r="6.5" />
      <line x1="15.3" y1="15.3" x2="20.5" y2="20.5" />
    </>
  )}
  {name === 'funnel' && <path d="M3.5 4.5h17l-6.5 7.5v6l-4 2v-8z" />}
  {name === 'users' && (
    <>
      <circle cx="9" cy="8" r="3.25" />
      <path d="M2.75 19c0-3.45 2.8-6 6.25-6s6.25 2.55 6.25 6" />
      <circle cx="17" cy="8.5" r="2.5" />
      <path d="M15.5 13.2c2.8.35 4.75 2.6 4.75 5.8" />
    </>
  )}
  {name === 'building' && (
    <>
      <rect x="4" y="3" width="12" height="18" rx="1" />
      <line x1="7.5" y1="7" x2="7.5" y2="7.01" />
      <line x1="12.5" y1="7" x2="12.5" y2="7.01" />
      <line x1="7.5" y1="11" x2="7.5" y2="11.01" />
      <line x1="12.5" y1="11" x2="12.5" y2="11.01" />
      <line x1="7.5" y1="15" x2="7.5" y2="15.01" />
      <line x1="12.5" y1="15" x2="12.5" y2="15.01" />
      <path d="M16 9h4v12h-4" />
      <line x1="9" y1="21" x2="9" y2="17" />
      <line x1="11" y1="21" x2="11" y2="17" />
    </>
  )}
  {name === 'star' && (
    <path
      stroke-linejoin="round"
      d="M12 3.2l2.75 5.58 6.15.9-4.45 4.34 1.05 6.13L12 17.1l-5.5 2.9 1.05-6.13-4.45-4.34 6.15-.9z"
    />
  )}
  {name === 'clock' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <polyline points="12,7 12,12 15.5,14" />
    </>
  )}
  {name === 'external-link' && (
    <>
      <path d="M9.5 6H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-3.5" />
      <polyline points="14,4 20,4 20,10" />
      <line x1="10" y1="14" x2="20" y2="4" />
    </>
  )}
  {name === 'award' && (
    <>
      <circle cx="12" cy="8.5" r="5.5" />
      <polyline points="8.5,13.2 7,21 12,18.5 17,21 15.5,13.2" />
    </>
  )}
  {name === 'expand' && (
    <>
      <polyline points="9,3 3,3 3,9" />
      <polyline points="15,3 21,3 21,9" />
      <polyline points="3,15 3,21 9,21" />
      <polyline points="21,15 21,21 15,21" />
    </>
  )}
  {name === 'bed' && (
    <>
      <path d="M2.5 19.5V11a2 2 0 0 1 2-2h15a2 2 0 0 1 2 2v8.5" />
      <line x1="2.5" y1="16.5" x2="21.5" y2="16.5" />
      <path d="M5.5 12.5V9a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3.5" />
      <line x1="2.5" y1="19.5" x2="2.5" y2="21.5" />
      <line x1="21.5" y1="19.5" x2="21.5" y2="21.5" />
    </>
  )}
  {name === 'bath' && (
    <>
      <path d="M4 12V6.5a2 2 0 0 1 3.2-1.6" />
      <path d="M2.5 12h19v2a6 6 0 0 1-6 6H8.5a6 6 0 0 1-6-6z" />
      <line x1="6" y1="20" x2="6" y2="22" />
      <line x1="18" y1="20" x2="18" y2="22" />
    </>
  )}
  {name === 'facebook' && (
    <>
      <circle cx="12" cy="12" r="9.25" />
      <path d="M13.8 21.6v-6.7h2.2l.3-2.6h-2.5v-1.7c0-.75.2-1.27 1.28-1.27h1.37V6.98c-.24-.03-1.05-.1-1.99-.1-1.97 0-3.32 1.2-3.32 3.42v1.9H9v2.6h2.09v6.7" />
    </>
  )}
  {name === 'zalo' && (
    <>
      <circle cx="12" cy="12" r="9.25" />
      <path d="M8 9.2h5.4L8.2 15h5.4" />
      <line x1="15.5" y1="9.2" x2="15.5" y2="15" />
    </>
  )}
  {name === 'youtube' && (
    <>
      <rect x="2.5" y="6" width="19" height="12" rx="3" />
      <path d="M10.5 9.7v4.6l4.2-2.3z" fill="currentColor" stroke="none" />
    </>
  )}
  {name === 'list' && (
    <>
      <circle cx="4.5" cy="6.5" r="1.15" fill="currentColor" stroke="none" />
      <circle cx="4.5" cy="12" r="1.15" fill="currentColor" stroke="none" />
      <circle cx="4.5" cy="17.5" r="1.15" fill="currentColor" stroke="none" />
      <line x1="9" y1="6.5" x2="21" y2="6.5" />
      <line x1="9" y1="12" x2="21" y2="12" />
      <line x1="9" y1="17.5" x2="21" y2="17.5" />
    </>
  )}
  {name === 'sparkle' && (
    <path d="M12 2.5c.5 3.2 1.2 5 2.4 6.4 1.3 1.3 3.1 2 6.1 2.5-3 .5-4.8 1.2-6.1 2.5-1.2 1.4-1.9 3.2-2.4 6.4-.5-3.2-1.2-5-2.4-6.4-1.3-1.3-3.1-2-6.1-2.5 3-.5 4.8-1.2 6.1-2.5C10.8 7.5 11.5 5.7 12 2.5z" />
  )}
</svg>
