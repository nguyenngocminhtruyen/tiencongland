---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { formatArea, formatPrice, statusLabel, typeLabel } from '@/lib/format';

interface Props {
  property: CollectionEntry<'properties'>;
}

const { property } = Astro.props;
const { title, status, propertyType, price, priceUnit, district, city, bedrooms, bathrooms, area, images } = property.data;
---

<article class="card group flex flex-col overflow-hidden hover:shadow-card-hover">
  <a href={`/properties/${property.id}`} class="relative block aspect-[4/3] overflow-hidden bg-primary-100">
    <img
      src={images[0]}
      alt={title}
      loading="lazy"
      decoding="async"
      width="1200"
      height="900"
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
    <span class="absolute left-3 top-3 rounded-full bg-primary-900/90 px-3 py-1 text-xs font-medium text-white backdrop-blur">
      {statusLabel(status)}
    </span>
    <span class="absolute right-3 top-3 rounded-full bg-white/90 px-3 py-1 text-xs font-medium text-primary-800 backdrop-blur">
      {typeLabel(propertyType)}
    </span>
  </a>
  <div class="flex flex-1 flex-col p-5">
    <a href={`/properties/${property.id}`} class="line-clamp-2 font-serif text-lg font-semibold text-primary-900 hover:text-accent-600">
      {title}
    </a>
    <p class="mt-1.5 flex items-center gap-1.5 text-sm text-primary-500">
      <Icon name="map-pin" size={16} class="shrink-0 text-primary-400" />
      {district}, {city}
    </p>

    <div class="mt-4 flex items-center gap-4 text-sm text-primary-600">
      {bedrooms > 0 && (
        <span class="flex items-center gap-1.5">
          <Icon name="bed" size={17} class="text-primary-400" />
          {bedrooms} PN
        </span>
      )}
      {bathrooms > 0 && (
        <span class="flex items-center gap-1.5">
          <Icon name="bath" size={17} class="text-primary-400" />
          {bathrooms} WC
        </span>
      )}
      <span class="flex items-center gap-1.5">
        <Icon name="expand" size={16} class="text-primary-400" />
        {formatArea(area)}
      </span>
    </div>

    <div class="mt-4 flex items-center justify-between border-t border-border pt-4">
      <span class="font-serif text-xl font-semibold text-accent-600">{formatPrice(price, priceUnit)}</span>
      <a href={`/properties/${property.id}`} class="flex items-center gap-1 text-sm font-medium text-primary-700 hover:text-accent-600">
        Chi tiết
        <Icon name="arrow-right" size={16} />
      </a>
    </div>
  </div>
</article>
