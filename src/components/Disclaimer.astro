---
import Icon from './Icon.astro';

interface Props {
  text: string;
  secondaryText?: string;
  class?: string;
  variant?: 'inline' | 'box';
}

const { text, secondaryText, class: className = '', variant = 'inline' } = Astro.props;
---

{
  variant === 'box' ? (
    <aside class:list={['rounded-lg border border-border bg-primary-50/60 p-5', className]}>
      <div class="flex items-start gap-3">
        <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-white text-primary-400 shadow-subtle">
          <Icon name="shield-check" size={15} />
        </span>
        <div class="space-y-2">
          <p class="text-xs font-medium uppercase tracking-wide text-primary-400">Thông tin tham khảo</p>
          <p class="text-sm leading-relaxed text-primary-600">{text}</p>
          {secondaryText && <p class="text-xs leading-relaxed text-primary-400">{secondaryText}</p>}
        </div>
      </div>
    </aside>
  ) : (
    <p class:list={['flex items-start gap-2 text-xs leading-relaxed text-primary-400', className]}>
      <span aria-hidden="true">ⓘ</span>
      <span>{text}</span>
    </p>
  )
}
