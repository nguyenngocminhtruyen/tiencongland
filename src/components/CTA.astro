---
import Icon from './Icon.astro';

interface Props {
  title: string;
  text: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  class?: string;
  compact?: boolean;
}

const {
  title,
  text,
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
  class: className = '',
  compact = false,
} = Astro.props;
---

<div
  class:list={[
    'rounded-xl border border-accent-200/70 bg-gradient-to-br from-accent-50 via-surface-card to-surface-card shadow-card',
    compact ? 'p-5' : 'p-6 sm:p-8',
    className,
  ]}
>
  <div class:list={['flex flex-col gap-5', !compact && 'sm:flex-row sm:items-center sm:justify-between sm:gap-8']}>
    <div>
      <p class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wide text-accent-600">
        <Icon name="sparkle" size={13} class="shrink-0" filled />
        Tư vấn 1:1
      </p>
      <h2 class:list={['mt-2 font-serif font-semibold text-primary-900', compact ? 'text-lg' : 'text-xl sm:text-2xl']}>
        {title}
      </h2>
      <p class="mt-2 max-w-xl text-sm leading-relaxed text-primary-500">{text}</p>
    </div>
    <div class="flex shrink-0 flex-col gap-3 sm:flex-row">
      <a href={primaryHref} class="btn-accent justify-center">
        <Icon name="phone" size={17} />
        {primaryLabel}
      </a>
      {secondaryLabel && secondaryHref && (
        <a href={secondaryHref} class="btn-outline justify-center">
          {secondaryLabel}
          <Icon name="arrow-right" size={17} />
        </a>
      )}
    </div>
  </div>
</div>
