---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, tagline, location, type, status, heroImage } = project.data;
const href = `/projects/${project.id}`;
---

<article class="card group flex flex-col overflow-hidden hover:shadow-card-hover">
  <a href={href} class="relative block aspect-[4/3] overflow-hidden bg-primary-100">
    <img
      src={heroImage}
      alt={title}
      loading="lazy"
      decoding="async"
      width="1200"
      height="900"
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
    <span class="absolute left-3 top-3 rounded-full bg-primary-900/90 px-3 py-1 text-xs font-medium text-white backdrop-blur">
      {status}
    </span>
    <span class="absolute right-3 top-3 rounded-full bg-white/90 px-3 py-1 text-xs font-medium text-primary-800 backdrop-blur">
      {type}
    </span>
  </a>
  <div class="flex flex-1 flex-col p-5">
    <a href={href} class="line-clamp-2 font-serif text-lg font-semibold text-primary-900 hover:text-accent-600">
      {title}
    </a>
    <p class="mt-1.5 flex items-center gap-1.5 text-sm text-primary-500">
      <Icon name="map-pin" size={16} class="shrink-0 text-primary-400" />
      <span class="line-clamp-1">{location}</span>
    </p>
    <p class="mt-3 line-clamp-2 flex-1 text-sm text-primary-500">{tagline}</p>

    <div class="mt-5 flex flex-col gap-2 border-t border-border pt-4 sm:flex-row">
      <a href={href} class="btn-accent flex-1 justify-center text-sm">
        Xem chi tiết
        <Icon name="arrow-right" size={16} />
      </a>
      <a href="/contact" class="btn-outline flex-1 justify-center text-sm">
        Liên hệ tư vấn
      </a>
    </div>
  </div>
</article>
