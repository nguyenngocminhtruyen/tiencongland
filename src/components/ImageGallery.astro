---
interface GalleryItem {
  src: string;
  alt: string;
  caption?: string;
}

interface Props {
  items: GalleryItem[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

<div class:list={['grid gap-4 sm:grid-cols-2 lg:grid-cols-3', className]}>
  {items.map((img) => (
    <figure class="group overflow-hidden rounded-lg border border-border shadow-subtle">
      <div class="overflow-hidden">
        <img
          src={img.src}
          alt={img.alt}
          loading="lazy"
          decoding="async"
          width="800"
          height="600"
          class="aspect-[4/3] w-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
      </div>
      {img.caption && <figcaption class="px-4 py-3 text-sm text-primary-500">{img.caption}</figcaption>}
    </figure>
  ))}
</div>
